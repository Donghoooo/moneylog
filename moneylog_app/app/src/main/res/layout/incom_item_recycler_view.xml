<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1A1A2E"
    android:orientation="horizontal"
    android:id="@+id/linear_income"
    android:padding="8dp"
    android:gravity="center_vertical">

    <CheckBox
        android:id="@+id/todoCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#FFA04D"
        android:textColor="@android:color/white"/>


    <TextView
        android:id="@+id/incomItemCateData"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="Todo Item"
        android:textColor="@android:color/white"
        android:paddingStart="8dp"/>

    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_delete"
        android:tint="@android:color/white"/>

    <TextView
        android:id="@+id/incomItemMemoData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="숨겨질 텍스트"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/incomItemSourceData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="숨겨질 텍스트"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/incomItemUseData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="숨겨질 텍스트"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/incomItemSeqData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="숨겨질 텍스트"
        android:visibility="gone"/>
</LinearLayout>


