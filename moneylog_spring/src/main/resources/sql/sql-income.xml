<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="bitc.fullstack503.moneylog_spring.mapper.IncomeMapper">

<!-- 수입 내역 입력하기 -->
    <insert id="signUpProcess" parameterType="bitc.fullstack503.moneylog_spring.dto.TodoListDTO">
        insert into
            todo_list(todo_title)
        values
            (#{todoTitle})
    </insert>

<!--    todo 내용 수정하기 -->
    <update id="todoUpdate" parameterType="bitc.fullstack503.moneylog_spring.dto.TodoListDTO">
        update todo_list
        set todo_title =#{todoTitle}, todo_status =#{todoStatus}, todo_memo = #{todoMemo}, todo_Status = #{todoStatus}
        where todo_seq = #{todoSeq};
    </update>

<!--    todo 내용 삭제하기 -->
    <delete id="todoDelete" parameterType="int">
        DELETE FROM todo_list
        where todo_seq = #{todoSeq}
    </delete>


</mapper>